# Port the web service listens on.
PORT=9780

# Optional. Raises the GitHub API rate limit from 60/hr to 5000/hr and unlocks
# private repos. Only needs read access to public repos when left empty.
GITHUB_TOKEN=

# Where shallow clones, generated covers, and the on-disk cache are written.
DATA_DIR=./data

# Hard ceiling on a single render. Slow builds get killed here.
RENDER_TIMEOUT_MS=90000

# How long a completed render stays in the cache before it is regenerated.
CACHE_TTL_MS=21600000

# Renders allowed to run at the same time. Each one holds a Playwright page and
# a preview process, so keep this at or below the container memory budget.
RENDER_CONCURRENCY=2

# Allow `npm install` + dev-server launches. Off by default: installs are slow and
# they execute third-party lifecycle scripts. Turn on only for repos you trust.
ALLOW_INSTALLS=false
